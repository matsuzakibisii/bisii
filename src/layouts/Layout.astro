---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
}

const {
  title,
  description,
  path = "/",
  ogImage = "/og-image.png",
} = Astro.props;

const siteUrl = "https://www.bisii.co.jp";
const canonical = new URL(path, siteUrl).toString();
const fullTitle = path === "/" ? title : `${title} | 株式会社ビシィッ`;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "株式会社ビシィッ",
  alternateName: "Bisii.co,ltd",
  url: siteUrl,
  foundingDate: "2016-04-11",
  address: {
    "@type": "PostalAddress",
    addressRegion: "神奈川県",
    addressLocality: "逗子市新宿",
    addressCountry: "JP",
  },
  description:
    "株式会社ビシィッは表にでてこない「代表以外が超精鋭の事業企画とwebサービスの開発会社」です。FDE（Forward Deployed Engineering）とAI駆動の成長支援を得意としています。",
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bisii.co,ltd | 株式会社ビシィッ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgJsonLd)}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
