---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="ブログ"
  description="株式会社ビシィッが発信する、FDE・AI活用・新規事業開発・データ分析に関する記事一覧です。"
  path="/blog"
>
  <section class="page-hero wrap">
    <p class="eyebrow">Blog</p>
    <h1 class="display">ブログ</h1>
    <p class="lead">FDE・AI活用・新規事業開発・データ分析に関する知見を発信しています。</p>
  </section>

  <section class="page-body wrap posts">
    {
      posts.map((post) => (
        <a class="post" href={`/blog/${post.id}/`}>
          <time>
            {post.data.pubDate.toLocaleDateString("ja-JP", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      ))
    }
  </section>
</Layout>

<style>
  .posts {
    max-width: 720px;
  }
  .post {
    display: block;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }
  .post time {
    font-size: 12px;
    color: var(--accent);
  }
  .post h2 {
    font-size: 19px;
    font-weight: 700;
    margin: 10px 0 8px;
  }
  .post p {
    margin: 0;
  }
</style>
