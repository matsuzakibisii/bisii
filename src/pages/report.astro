---
import Layout from "../layouts/Layout.astro";

const achievements = [
  "超高負荷の位置情報系サービス開発（国内販売数１位）",
  "上場企業での新規事業開発〜運用 10件以上",
  "マーケティング戦略〜実施でのユーザー登録実績 100万人以上",
  "1事業での売上実績 最大5億以上",
  "データ分析による売上改善実績 1億以上",
  "不動産会社のDX推進業務、新規事業立上、試算計画（KPI〜試算表、事業計画書等の作成・調査）〜運用改善、組織改変",
  "アプリゲーム開発および部門立ち上げ　年商10億以上、MAU150万",
  "カーボンニュートラルSAAS立ち上げ",
  "ファンコミュニティ月額サービスの企画・立ち上げ",
  "位置情報系サービス企画開発",
  "スキューバダイビングアプリ開発",
  "ゴルフスコアアプリ開発",
  "LINEミニアプリの開発",
  "美容系予約システム開発",
  "Shopify導入支援",
  "Salesforce導入支援、および開発",
  "スポーツベッティングサービス開発、会計システム開発",
  "エンタメ系疑似ライブ配信アプリのサービス企画・開発・運用",
  "カジュアルゲーム開発１０本以上",
  "地方創生、外国人労働者の受入のための訓練校開設支援",
];

const clients = [
  "株式会社ミクシィ",
  "株式会社サクセス",
  "UUUM株式会社",
  "株式会社ORSO",
  "株式会社アイ・グリッド・ソリューションズ",
  "株式会社ジョルテ",
  "株式会社ドキドキファクトリー",
  "株式会社GENZ",
  "株式会社ジェクトワン",
  "ポールトゥウィン株式会社",
  "株式会社エディア",
  "一般社団法人LBMA JAPAN 会員",
];
---

<Layout
  title="開発実績"
  description="株式会社ビシィッのこれまでの開発実績・取引実績をご紹介します。位置情報サービス、アプリ開発、データ分析、新規事業立ち上げまで幅広く対応してきました。"
  path="/report"
>
  <section class="page-hero wrap">
    <p class="eyebrow">Track Record</p>
    <h1 class="display">開発実績</h1>
    <p class="lead">
      メガベンチャー出身の精鋭メンバーが手掛けてきた、新規事業開発・アプリ開発・データ分析・インフラ構築の実績の一部です。
    </p>
  </section>

  <section class="page-body wrap">
    <h2>実績一覧</h2>
    <ul>
      {achievements.map((item) => <li>{item}</li>)}
    </ul>

    <h2>取引先（敬称略）</h2>
    <ul>
      {clients.map((c) => <li>{c}</li>)}
    </ul>

    <div class="page-cta">
      <a class="btn" href="/contact">同じような課題を相談する</a>
    </div>
  </section>
</Layout>
